generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pedido {
  id         Int      @id @default(autoincrement())
  cliente    String
  correo     String
  telefono   String
  direccion  String
  total      Float
  createdAt  DateTime @default(now())
}